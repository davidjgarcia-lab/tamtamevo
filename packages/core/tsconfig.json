{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2022.Intl"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src"]
}
