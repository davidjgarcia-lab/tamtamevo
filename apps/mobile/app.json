{
  "expo": {
    "name": "TamTam EVO",
    "slug": "tamtam-evolution",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#22144A",
        "foregroundImage": "./assets/brand/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "TamTam EVO",
      "shortName": "TamTam EVO",
      "themeColor": "#17132B",
      "backgroundColor": "#17132B"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#17132B"
        }
      ]
    ],
    "backgroundColor": "#17132B",
    "description": "TamTam Evolution — Un mundo de criaturas que crecen contigo."
  }
}
